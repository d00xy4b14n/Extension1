local function getAreaBox(index)
    if not boxPool[index] then
        local box = Instance.new("BoxHandleAdornment")
        box.Name = "AutoPosAreaBox_" .. index
        box.Size = Vector3.new(40, 0.1, 40) 
        box.Color3 = Color3.fromRGB(255, 0, 0)
        box.Transparency = 0.6
        box.AlwaysOnTop = true
        box.Adornee = workspace.Terrain
        box.Visible = false
        box.Parent = workspace
        boxPool[index] = box
    end
    return boxPool[index]
end

local function hideAllBoxes()
    for _, box in ipairs(boxPool) do
        box.Visible = false
    end
end

local function getClosestLayer(y)
    local closest = LAYERS[1]
    local minDiff = math.abs(y - LAYERS[1])
    for i = 2, #LAYERS do
        local diff = math.abs(y - LAYERS[i])
        if diff < minDiff then
            minDiff = diff
            closest = LAYERS[i]
        end
    end
    return closest
end

local function getAllEntityPositions()
    local entityPositions = {}
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return entityPositions end

    local myLayer = getClosestLayer(myHrp.Position.Y)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local targetLayer = getClosestLayer(hrp.Position.Y)
                if targetLayer == myLayer and math.abs(hrp.Position.Y - myLayer) <= Y_TOLERANCE then
                    table.insert(entityPositions, hrp.Position)
                end
            end
        end
    end

    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") and child ~= myChar and not Players:GetPlayerFromCharacter(child) then
            local hum = child:FindFirstChildOfClass("Humanoid")
            local hrp = child:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                local targetLayer = getClosestLayer(hrp.Position.Y)
                if targetLayer == myLayer and math.abs(hrp.Position.Y - myLayer) <= Y_TOLERANCE then
                    table.insert(entityPositions, hrp.Position)
                end
            end
        end
    end

    return entityPositions
end

local function getAllClustersData()
    local positions = getAllEntityPositions()
    local validClusters = {}
    local validCenters = {}

    for i, pos1 in ipairs(positions) do
        local cluster = {pos1}
        
        for j, pos2 in ipairs(positions) do
            if i ~= j then
                local dx = math.abs(pos1.X - pos2.X)
                local dz = math.abs(pos1.Z - pos2.Z)
                
                if dx <= 20 and dz <= 20 then
                    table.insert(cluster, pos2)
                end
            end
        end

        if #cluster > 10 then
            table.sort(cluster, function(a, b)
                return (a - pos1).Magnitude < (b - pos1).Magnitude
            end)
            local trimmedCluster = {}
            for k = 1, 10 do
                table.insert(trimmedCluster, cluster[k])
            end
            cluster = trimmedCluster
        end

        local count = #cluster

        if count >= 2 and count <= 10 then
            local sum = Vector3.zero
            for _, p in ipairs(cluster) do
                sum = sum + p
            end
            local center = sum / count

            local isDuplicate = false
            for _, existingCenter in ipairs(validCenters) do
                if (existingCenter - center).Magnitude < 20 then
                    isDuplicate = true
                    break
                end
            end

            if not isDuplicate then
                table.insert(validClusters, cluster)
                table.insert(validCenters, center)
            end
        end
    end

    return validClusters, validCenters
end

local function teleportAbove(targetPos, track)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not char then return end

    local destination = targetPos + Vector3.new(0, 150, 0)
    local destinationCFrame = CFrame.new(destination)
    
    local distance = (destination - hrp.Position).Magnitude
    local dynamicSpeed = math.clamp(1.0 + (distance / 120), 1.2, 3.0)

    local tweenInfo = TweenInfo.new(dynamicSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = destinationCFrame})
    
    tween:Play()

    tween.Completed:Connect(function()
        local holdConnection
        holdConnection = RunService.Heartbeat:Connect(function()
            if track and track.IsPlaying and hrp and hrp.Parent then
                hrp.CFrame = destinationCFrame
                hrp.AssemblyLinearVelocity = Vector3.zero
            else
                if holdConnection then
                    holdConnection:Disconnect()
                end
            end
        end)
    end)
end

local function listenToAnimation(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    local animator = humanoid and humanoid:WaitForChild("Animator", 5)
    if not animator then return end

    animator.AnimationPlayed:Connect(function(track)
        if not autoPosEnabled then return end

        if track.Animation and string.find(track.Animation.AnimationId, TARGET_ANIM_ID) then
            local _, centers = getAllClustersData()
            
            if #centers > 0 then
                local myHrp = char:FindFirstChild("HumanoidRootPart")
                local closestCenter = centers[1]
                
                if myHrp then
                    local minDist = (centers[1] - myHrp.Position).Magnitude
                    for i = 2, #centers do
                        local dist = (centers[i] - myHrp.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            closestCenter = centers[i]
                        end
                    end
                end
                
                teleportAbove(closestCenter, track)
            end
        end
    end)
end

if LocalPlayer.Character then
    listenToAnimation(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(listenToAnimation)

task.spawn(function()
    while true do
        if autoPosEnabled then
            local _, centers = getAllClustersData()
            
            if #centers > 0 then
                for i, center in ipairs(centers) do
                    local box = getAreaBox(i)
                    box.CFrame = CFrame.new(center)
                    box.Visible = true
                end
                for i = #centers + 1, #boxPool do
                    boxPool[i].Visible = false
                end
            else
                hideAllBoxes()
            end
        else
            hideAllBoxes()
        end
        task.wait(0.05)
    end
end)

local function setToggleState(state)
    autoPosEnabled = state

    if autoPosEnabled then
        TweenService:Create(toggleTrack, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(0, 185, 140)}):Play()
        TweenService:Create(toggleKnob, TweenInfo.new(0.15), {Position = UDim2.new(0.905, -19, 0.5, 0)}):Play()
    else
        TweenService:Create(toggleTrack, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(75, 75, 75)}):Play()
        TweenService:Create(toggleKnob, TweenInfo.new(0.15), {Position = UDim2.new(0, 3, 0.5, 0)}):Play()
        hideAllBoxes()
    end
end

