local function findExistingButtonTemplate()
    local getHui = gethui or function() return game:GetService("CoreGui") end
    local containers = {PlayerGui, getHui()}

    for _, container in ipairs(containers) do
        for _, gui in ipairs(container:GetChildren()) do
            if gui:IsA("ScreenGui") and not gui.Name:lower():find("dex") then
                for _, descendant in ipairs(gui:GetDescendants()) do
                    if descendant:IsA("ScrollingFrame") then
                        for _, child in ipairs(descendant:GetChildren()) do
                            if child.Name:sub(1, #baseButtonName) == baseButtonName and child:FindFirstChild("ToggleTrack") then
                                return descendant, child
                            end
                        end
                    end
                end
            end
        end
    end

    return nil, nil
end

local function findTargetByCanvasSize()
    while true do
        local getHui = gethui or function() return game:GetService("CoreGui") end
        local containers = {PlayerGui, getHui()}

        for _, container in ipairs(containers) do
            for _, gui in ipairs(container:GetChildren()) do
                if gui:IsA("ScreenGui") and not gui.Name:lower():find("dex") then
                    for _, descendant in ipairs(gui:GetDescendants()) do
                        if descendant:IsA("ScrollingFrame") and descendant.CanvasSize.Y.Offset == 674 then
                            return descendant
                        end
                    end
                end
            end
        end

        task.wait(0.5)
    end
end

