local function getAllEntityPositions()
    local entityPositions = {}
    local myChar = LocalPlayer.Character

    for _, descendant in ipairs(workspace:GetDescendants()) do
        if descendant:IsA("Humanoid") and descendant.Health > 0 then
            local char = descendant.Parent
            if char and char ~= myChar then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    table.insert(entityPositions, hrp.Position)
                end
            end
        end
    end

    return entityPositions
end

local function getDenseClusterCenter()
    local positions = getAllEntityPositions()
    local bestCenter = nil
    local maxCount = 0

    for i, pos1 in ipairs(positions) do
        local cluster = {pos1}
        
        for j, pos2 in ipairs(positions) do
            if i ~= j then
                local dx = math.abs(pos1.X - pos2.X)
                local dz = math.abs(pos1.Z - pos2.Z)
                
                if dx <= 10 and dz <= 10 then
                    table.insert(cluster, pos2)
                end
            end
        end

        local count = #cluster
        if count >= 3 and count <= 10 and count > maxCount then
            maxCount = count
            local sum = Vector3.zero
            for _, p in ipairs(cluster) do
                sum = sum + p
            end
            bestCenter = sum / count
        end
    end

    if not bestCenter and #positions >= 3 then
        for i, pos1 in ipairs(positions) do
            local cluster = {pos1}
            for j, pos2 in ipairs(positions) do
                if i ~= j and math.abs(pos1.X - pos2.X) <= 10 and math.abs(pos1.Z - pos2.Z) <= 10 then
                    table.insert(cluster, pos2)
                end
            end
            if #cluster >= 3 then
                local sum = Vector3.zero
                for _, p in ipairs(cluster) do sum = sum + p end
                bestCenter = sum / #cluster
                break
            end
        end
    end

    return bestCenter
end

local function teleportAbove(targetPos, track)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not char then return end

    local destination = targetPos + Vector3.new(0, 150, 0)
    local destinationCFrame = CFrame.new(destination)
    
    local tweenInfo = TweenInfo.new(TWEEN_SPEED, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = destinationCFrame})
    
    tween:Play()

    tween.Completed:Connect(function()
        local holdConnection
        holdConnection = RunService.Heartbeat:Connect(function()
            if track and track.IsPlaying and hrp and hrp.Parent then
                hrp.CFrame = destinationCFrame
                hrp.AssemblyLinearVelocity = Vector3.zero
            else
                if holdConnection then
                    holdConnection:Disconnect()
                end
            end
        end)
    end)
end

local function listenToAnimation(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    local animator = humanoid and humanoid:WaitForChild("Animator", 5)
    if not animator then return end

    animator.AnimationPlayed:Connect(function(track)
        if not autoPosEnabled then return end

        if track.Animation and string.find(track.Animation.AnimationId, TARGET_ANIM_ID) then
            local clusterCenter = getDenseClusterCenter()
            
            if clusterCenter then
                teleportAbove(clusterCenter, track)
            end
        end
    end)
end

if LocalPlayer.Character then
    listenToAnimation(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(listenToAnimation)
